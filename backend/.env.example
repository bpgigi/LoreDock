# Optional local runtime options (PowerShell: $env:LOREDOCK_MODEL_TIMEOUT = '60').
# API keys are entered in the application settings and encrypted with Windows DPAPI.
# Unset timeout: 60s normally, 180s for high, 300s for xhigh. An explicit value overrides all efforts.
LOREDOCK_MODEL_TIMEOUT=60
LOREDOCK_CONTEXT_CHARS=24000
# LOREDOCK_DATA_DIR=./data
