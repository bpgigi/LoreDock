{
  "name": "loredock-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LoreDock personal knowledge workspace",
  "author": "LoreDock",
  "main": "src/main.cjs",
  "scripts": {
    "start": "npm --prefix ../frontend run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node scripts/build.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.loredock.desktop",
    "productName": "LoreDock",
    "asar": true,
    "directories": { "output": "../release" },
    "files": ["src/**", "assets/**", "package.json"],
    "extraResources": [
      { "from": "../frontend/dist", "to": "frontend" },
      { "from": "build/backend/loredock-backend", "to": "backend" }
    ],
    "win": { "target": ["dir"], "icon": "assets/loredock.ico", "signExecutable": false }
  }
}
