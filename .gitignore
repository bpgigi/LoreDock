# Publish only the application, tests, and curated project documentation.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/frontend/
!/backend/
!/desktop/
!/docs/
!/tools/
!/启动LoreDock.bat
!/停止LoreDock.bat
!/启动LoreDock桌面版.bat

# Curated documentation and synthetic screenshots.
/docs/*
!/docs/ARCHITECTURE.md
!/docs/DESKTOP.md
!/docs/USER_GUIDE.md
!/docs/TESTING.md
!/docs/assets/
/docs/assets/*
!/docs/assets/chat.png
!/docs/assets/search.png

# Runtime helpers only; private corpus tools and evaluation stay local.
/tools/*
!/tools/loredock.ps1
!/tools/migrate_desktop_data.py
/backend/tests/test_retrieval_evaluation.py

# Runtime data, credentials, development state and build products.
.venv/
node_modules/
dist/
build/
release/
.qa/
__pycache__/
.pytest_cache/
.idea/
.vscode/
data/
uploads/
*.tsbuildinfo
*.pyc
*.log
*.sqlite*
*.db
*.db-*
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
AGENTS.md

# Source templates, course deliverables, recordings and archives.
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.pdf
*.mp4
*.zip
*.rar
*.lnk
~$*